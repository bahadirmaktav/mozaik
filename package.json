  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "format": "prettier --write src tests scripts *.ts *.json *.html *.md docs .github",
    "format:check": "prettier --check src tests scripts *.ts *.json *.html *.md docs .github",
    "benchmark:editor": "node scripts/benchmark-editor.mjs",
    "conpty": "node scripts/conpty.mjs",
    "package:windows": "tauri build --bundles nsis --config src-tauri/tauri.conpty.conf.json"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/lang-css": "^6",
